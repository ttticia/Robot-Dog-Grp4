<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>team_perception</name>
  <version>0.0.0</version>
  <description>QR code scanner and YOLO person detector nodes, webcam/video bridge,
    and an offline tool that annotates photos and videos into test_runs/.</description>
  <maintainer email="ng.tricia2005@gmail.com">ngtri</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <!-- Humble's OpenCV is built without QUIRC and cannot decode QR codes -->
  <exec_depend>python3-pyzbar</exec_depend>
  <!-- Also needs zxing-cpp, ultralytics and CPU torch from pip (no rosdep keys):
       see requirements.txt -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-qrcode</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
